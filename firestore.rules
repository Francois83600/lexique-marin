rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Classement : tout le monde lit ; chaque joueur (identifiant anonyme Firebase)
    // n'écrit que sa propre ligne, nommée d'après son identifiant.
    match /scores/{playerId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == playerId
        && request.resource.data.keys().hasOnly(['name', 'pts', 'at', 'week', 'weekPts', 'wPts', 'fPts', 'day', 'dayPts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.pts is int
        && request.resource.data.pts >= 0
        && request.resource.data.pts <= 1000000
        && request.resource.data.get('week', '') is string
        && request.resource.data.get('week', '').size() <= 10
        && request.resource.data.get('day', '') is string
        && request.resource.data.get('day', '').size() <= 10
        && request.resource.data.get('weekPts', 0) is int
        && request.resource.data.get('weekPts', 0) >= 0
        && request.resource.data.get('weekPts', 0) <= request.resource.data.pts
        && request.resource.data.get('wPts', 0) is int
        && request.resource.data.get('wPts', 0) >= 0
        && request.resource.data.get('fPts', 0) is int
        && request.resource.data.get('fPts', 0) >= 0
        && request.resource.data.get('dayPts', 0) is int
        && request.resource.data.get('dayPts', 0) >= 0
        && request.resource.data.get('dayPts', 0) <= 5000;
      allow delete: if false;
    }
    // Transfert de progression vers un autre téléphone : code à 6 caractères,
    // valable 15 minutes, lisible seulement par qui connaît le code, effacé après usage.
    match /transfer/{code} {
      allow create: if request.auth != null
        && code.size() == 6
        && request.resource.data.keys().hasOnly(['s', 'rt', 'uid', 'exp'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.s is string
        && request.resource.data.s.size() < 300000
        && request.resource.data.rt is string
        && request.resource.data.exp is timestamp
        && request.resource.data.exp > request.time
        && request.resource.data.exp < request.time + duration.value(20, 'm');
      allow get: if resource.data.exp > request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
