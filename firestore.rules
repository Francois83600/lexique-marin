rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Classement : tout le monde lit ; chaque joueur (identifiant anonyme Firebase)
    // n'écrit que sa propre ligne, nommée d'après son identifiant.
    match /scores/{playerId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == playerId
        && request.resource.data.keys().hasOnly(['name', 'pts', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.pts is int
        && request.resource.data.pts >= 0
        && request.resource.data.pts <= 1000000;
      allow delete: if false;
    }
  }
}
